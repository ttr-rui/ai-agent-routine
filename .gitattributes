# 统一文本与换行行为，避免 Windows / macOS 协作时出现"整文件变更"
* text=auto eol=lf

# Windows 启动脚本保留 CRLF，避免部分环境解析异常
*.ps1 text eol=crlf
*.bat text eol=crlf

# 代码与文档统一 UTF-8
*.py   text diff=python
*.md   text diff=markdown
*.mmd  text
*.json text
*.yml  text
*.yaml text

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.gif binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.db  binary
