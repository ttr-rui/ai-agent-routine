# 复制本文件为 .env 后填写自己的 key（.env 不要提交到 GitHub）

# ===== LLM 配置（三选一即可，都是 OpenAI 兼容格式）=====
# 1) DeepSeek（最便宜，推荐作业用）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2) OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 3) 阿里通义千问（兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ===== 其他配置 =====
# 离线演示模式：设为 1 时用内置规则假大脑代替 LLM，不花一分钱、不需要 key
# 就能把「说话 → 调工具 → 写库 → 回复」整条链路跑通（仅用于验证架构，不体现智能）
USE_MOCK_LLM=0

TASK_DB_PATH=data/tasks.db     # SQLite 数据库路径
AGENT_MAX_STEPS=8              # 单次对话最多调用多少轮工具（防死循环）
AGENT_HISTORY_TURNS=20         # 多轮记忆保留最近多少条消息
